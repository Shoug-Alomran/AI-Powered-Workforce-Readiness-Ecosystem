# ─────────────────────────────────────────────────────────────
# Fursa AI pipeline — copy to .env and fill in
#
# App-specific settings are namespaced FURSA_* on purpose: bare names like
# CLAUDE_MODEL / CLAUDE_EFFORT are already used by other developer tooling and
# would silently override whatever you put here.
# ─────────────────────────────────────────────────────────────

# REQUIRED for every endpoint that reasons (all five ML functions + RAG answers).
ANTHROPIC_API_KEY=

# Claude model used for generation.
# claude-sonnet-4-6  -> as specified in the project brief
# claude-sonnet-5    -> newer Sonnet, stronger coding/agentic quality, same tier
# claude-opus-5      -> highest capability
FURSA_CLAUDE_MODEL=claude-sonnet-4-6

# Reasoning effort: low | medium | high | max  (higher = smarter, slower, pricier)
FURSA_CLAUDE_EFFORT=medium

# ─────────────────────────────────────────────────────────────
# Embeddings — pick ONE provider
#   local  -> ChromaDB's bundled ONNX MiniLM. Free, offline, no key. Default.
#   openai -> text-embedding-3-small. Set OPENAI_API_KEY.
#   cohere -> embed-multilingual-v3.0. Best for Arabic. Set COHERE_API_KEY.
# Changing provider requires re-running ingest (vectors are not comparable):
#   python scripts/ingest.py --reset
# ─────────────────────────────────────────────────────────────
FURSA_EMBEDDING_PROVIDER=local

OPENAI_API_KEY=
FURSA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

COHERE_API_KEY=
FURSA_COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# ─────────────────────────────────────────────────────────────
# Storage & retrieval
# ─────────────────────────────────────────────────────────────
FURSA_CHROMA_DIR=./data/chroma
FURSA_RAW_DIR=./data/raw
FURSA_MANUAL_DIR=./data/manual
FURSA_COLLECTION_NAME=fursa_kb

FURSA_CHUNK_SIZE=1100
FURSA_CHUNK_OVERLAP=150
FURSA_RAG_TOP_K=6

# Comma-separated origins allowed to call the API from a browser. * = any.
FURSA_CORS_ORIGINS=*
