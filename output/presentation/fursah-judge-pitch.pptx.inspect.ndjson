{"kind":"textbox","id":"sh/itwbet8b","slide":2,"text":"Academic evidence","textPreview":"Academic evidence","textChars":17,"textLines":1,"bbox":[88,246,300,46]}
{"kind":"textbox","id":"sh/ju5snypw","slide":2,"text":"Courses and mastery signals rarely translate cleanly into employability evidence.","textPreview":"Courses and mastery signals rarely translate cleanly into employability evidence.","textChars":81,"textLines":1,"bbox":[88,306,300,94]}
{"kind":"shape","id":"sh/byx03yhk","slide":2,"bbox":[446,178,350,258]}
