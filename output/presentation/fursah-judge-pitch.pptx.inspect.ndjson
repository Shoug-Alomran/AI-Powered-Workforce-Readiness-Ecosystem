{"kind":"textbox","id":"sh/x0fi58za","slide":2,"text":"Career requirements","textPreview":"Career requirements","textChars":19,"textLines":1,"bbox":[470,246,300,46]}
{"kind":"textbox","id":"sh/wz61w3y5","slide":2,"text":"Role expectations change faster than conventional advising artifacts.","textPreview":"Role expectations change faster than conventional advising artifacts.","textChars":69,"textLines":1,"bbox":[470,306,300,94]}
{"kind":"shape","id":"sh/nud0zeh8","slide":2,"bbox":[828,178,350,258]}
