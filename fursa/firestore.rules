rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validRole(role) { return role in ['STUDENT', 'EMPLOYER', 'UNIVERSITY']; }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validRole(request.resource.data.role);
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if owns(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
