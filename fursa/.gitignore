# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local prototype data and assistant tooling
/prisma/*.db
/prisma/*.db-journal
/.agents/
/.claude/
/.windsurf/
/AGENTS.md
/CLAUDE.md
/skills-lock.json
.turso-temp.env

# iCloud Drive conflict copies. This project lives under a synced ~/Desktop, and
# iCloud resolves sync conflicts by writing "name 2.ts", "name 3.tsx" alongside
# the original. They are never real source, but they do get compiled and
# type-checked, so keep them out of the repository.
* [0-9].ts
* [0-9].tsx
* [0-9].js
* [0-9].json
* [0-9].css
*.d [0-9].ts
