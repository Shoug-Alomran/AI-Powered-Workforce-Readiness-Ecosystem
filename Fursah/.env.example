# Fursah environment configuration
#
# Copy to .env.local and fill in. Never commit the filled copy — .env and
# .env.local are gitignored.
#
# The prototype runs without any of the optional blocks below. Readiness
# scoring, skill-gap analysis, roadmaps and opportunity matching are
# deterministic local logic and need no model API key. Leaving the AI blocks
# unset disables evidence extraction and the assistant; the rest of the
# platform, including human evidence review, continues to work.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development against a file:
DATABASE_URL="file:./prisma/dev.db"
# Hosted libSQL/Turso instead — set both:
# DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Authentication — Firebase (optional for local demo sign-in)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Admin SDK, server-side session verification.
# FIREBASE_PRIVATE_KEY keeps literal \n escapes inside the quotes.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Private evidence storage — Cloudflare R2 (optional)
# ---------------------------------------------------------------------------
# Without these, evidence upload is unavailable. Stored objects are private and
# are never served from a public URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ---------------------------------------------------------------------------
# AI services — Cloudflare Worker fronting Workers AI (optional)
# ---------------------------------------------------------------------------
# Evidence extraction. Output is always advisory: a human reviewer approves or
# rejects before any extracted skill becomes verified evidence.
EVIDENCE_AI_URL=""
EVIDENCE_AI_SECRET=""

# Role-scoped assistant. Falls back to EVIDENCE_AI_SECRET when unset, so the
# usual setup is to supply only the URL.
ASSISTANT_AI_URL=""
# ASSISTANT_AI_SECRET=""
