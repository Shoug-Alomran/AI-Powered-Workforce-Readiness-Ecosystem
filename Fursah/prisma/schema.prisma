// Prisma schema for the Fursah AI-Powered Workforce Readiness Ecosystem prototype

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  EMPLOYER
  UNIVERSITY
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  role      Role
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Set only for accounts created through local email + password sign-up, the
  // path used when Firebase is not configured. Firebase-backed and prepared
  // demo accounts leave it null and authenticate elsewhere.
  passwordHash String?

  student        Student?
  employer       Employer?
  university     University?
  auditEvents    AuditEvent[]
  notifications  Notification[]
  supportTickets SupportTicket[]
  documents      EvidenceDocument[]
}

model EvidenceDocument {
  id          String @id @default(cuid())
  ownerUserId String
  owner        User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  // What this evidence belongs to
  contextType String // CERTIFICATION | PROJECT | EXPERIENCE | APPLICATION | JOB | CURRICULUM_ACTION | OFFERING
  contextId   String
  purpose     String

  // Private R2 storage
  storageKey   String @unique
  originalName String
  mimeType     String
  sizeBytes    Int

  // AI-assisted evidence analysis
  aiStatus     String    @default("PENDING") // PENDING | COMPLETED | FAILED
  aiAnalysis   Json?
  aiAnalyzedAt DateTime?

  // Human verification
  reviewStatus String @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote   String?
  reviewedBy   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([contextType, contextId])
  @@index([reviewStatus, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([aiStatus, createdAt])
}

model University {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution String
  region      String?
  createdAt   DateTime @default(now())

  offerings         Offering[]
  curriculumActions CurriculumAction[]
}

model Student {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCareer String
  degree       String?
  university   String?
  bio          String?

  skills               StudentSkill[]
  certifications       StudentCertification[]
  experiences          Experience[]
  projects             Project[]
  applications         Application[]
  feedbacks            Feedback[]
  bookmarks            BookmarkedJob[]
  favoriteCompanies    FavoriteCompany[]
  favoriteCareerTracks FavoriteCareerTrack[]
  roadmapItems         RoadmapItem[]
  consents             ConsentRecord[]
  appeals              Appeal[]
  passportShares       PassportShare[]
  dataRequests         DataRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String // technical | soft

  studentSkills     StudentSkill[]
  jobSkills         JobSkill[]
  careerTrackSkills CareerTrackSkill[]
  offeringSkills    OfferingSkill[]
}

model StudentSkill {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     Int     @default(3) // 1-5 proficiency

  @@unique([studentId, skillId])
}

model Certification {
  id   String @id @default(cuid())
  name String @unique
  org  String?

  studentCerts     StudentCertification[]
  jobCerts         JobCertification[]
  careerTrackCerts CareerTrackCertification[]
  offerings        Offering[]
}

// -----------------------------------------------------------------------
// Career taxonomy (admin-editable). Seeded from src/lib/careerTracks.ts;
// once rows exist here they become the source of truth for readiness
// scoring, roadmaps, and the career-track pickers across the app.
// -----------------------------------------------------------------------

model CareerTrack {
  id                          String   @id // stable slug, e.g. "software-engineer"
  label                       String
  recommendedExperienceMonths Int      @default(6)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  trackSkills CareerTrackSkill[]
  trackCerts  CareerTrackCertification[]
}

model CareerTrackSkill {
  id            String      @id @default(cuid())
  careerTrackId String
  careerTrack   CareerTrack @relation(fields: [careerTrackId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  category      String // technical | soft
  weight        Int         @default(2) // importance 1-3

  @@unique([careerTrackId, skillId])
}

model CareerTrackCertification {
  id              String        @id @default(cuid())
  careerTrackId   String
  careerTrack     CareerTrack   @relation(fields: [careerTrackId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([careerTrackId, certificationId])
}

model StudentCertification {
  id                 String        @id @default(cuid())
  studentId          String
  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificationId    String
  certification      Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  earnedAt           DateTime      @default(now())
  evidencePath       String?
  evidenceName       String?
  evidenceType       String?
  verificationStatus String        @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedBy         String?

  @@unique([studentId, certificationId])
}

model Experience {
  id                 String   @id @default(cuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type               String // internship | research | volunteer | competition | hackathon | workshop
  title              String
  org                String?
  months             Int      @default(1)
  evidenceUrl        String?
  verificationStatus String   @default("SELF_REPORTED") // SELF_REPORTED | PENDING | APPROVED | REJECTED
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedBy         String?
  createdAt          DateTime @default(now())
}

model Project {
  id                 String   @id @default(cuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  evidenceUrl        String?
  verificationStatus String   @default("SELF_REPORTED") // SELF_REPORTED | PENDING | APPROVED | REJECTED
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedBy         String?
  createdAt          DateTime @default(now())
}

model Employer {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  String
  industry String?

  verificationStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedBy         String?

  jobs        Job[]
  favoritedBy FavoriteCompany[]

  createdAt DateTime @default(now())
}

model Job {
  id            String   @id @default(cuid())
  employerId    String
  employer      Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title         String
  careerTrack   String
  description   String?
  minExperience Int      @default(0) // months
  status        String   @default("open") // open | closed
  blindReview   Boolean  @default(false)
  createdAt     DateTime @default(now())

  requiredSkills JobSkill[]
  requiredCerts  JobCertification[]
  applications   Application[]
  feedbacks      Feedback[]
  bookmarks      BookmarkedJob[]
}

model JobSkill {
  id              String @id @default(cuid())
  jobId           String
  job             Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  weight          Int    @default(2) // importance 1-3
  requirementType String @default("ESSENTIAL") // ESSENTIAL | PREFERRED

  @@unique([jobId, skillId])
}

model JobCertification {
  id              String        @id @default(cuid())
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([jobId, certificationId])
}

model Application {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status         String   @default("applied") // applied | shortlisted | hired | rejected
  matchScore     Int      @default(0)
  note           String? // employer-visible reason shown back to the student
  decisionReason String?
  createdAt      DateTime @default(now())

  @@unique([studentId, jobId])
}

// A persisted learning plan lets the prototype demonstrate adaptation over
// time rather than recalculating a stateless list on every page load.

model RoadmapItem {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title    String
  category String

  status String @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | SKIPPED | STRUGGLING
  source String @default("AI") // AI | STUDENT | ADVISOR

  expectedImpact Int       @default(0)
  targetDate     DateTime?
  studentNote    String?

  // Used when this item is an alternative to another recommendation.
  alternativeForId String?

  // -----------------------------------------------------------------------
  // Intelligence metadata
  // -----------------------------------------------------------------------

  // Career direction that caused this recommendation.
  careerTrackId String?

  // Skill gap this roadmap item is intended to address.
  skillId String?

  // University offering associated with this recommendation.
  offeringId String?

  // Certification associated with this recommendation.
  certificationId String?

  // Explanation generated from the deterministic recommendation inputs.
  recommendationReason String?

  // Internal ranking score used by the recommendation engine.
  recommendationScore Float?

  // When the intelligence engine generated or regenerated this recommendation.
  generatedAt DateTime?

  // Explicit dismissal is a stronger negative-interest signal than simply
  // leaving an item unfinished.
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([studentId, careerTrackId])
  @@index([studentId, skillId])
  @@index([studentId, offeringId])
}

model ConsentRecord {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  purpose   String
  granted   Boolean  @default(false)
  version   String   @default("1.0")
  updatedAt DateTime @updatedAt

  @@unique([studentId, purpose])
}

model PassportShare {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token     String    @unique
  label     String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model DataRequest {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type       String // ACCESS | DOWNLOAD | CORRECTION | DELETION
  details    String?
  status     String   @default("OPEN") // OPEN | PROCESSING | COMPLETED | REJECTED
  resolution String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
}

model Appeal {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectType String // READINESS | MATCH | EVIDENCE | DATA
  subjectId   String?
  reason      String
  status      String   @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | REJECTED
  resolution  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  modelVersion String?
  explanation  String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

model GovernanceScenario {
  id             String   @id @default(cuid())
  title          String
  scenarioType   String
  description    String
  riskLevel      String
  detectedIssues String
  proposedAction String
  humanDecision  String   @default("PENDING") // PENDING | APPROVED | OVERRIDDEN
  decisionNote   String?
  createdBy      String
  createdAt      DateTime @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
}

model MonitoringSnapshot {
  id           String   @id @default(cuid())
  modelVersion String
  sampleSize   Int
  averageScore Float
  outcomeRate  Float
  scoreDrift   Float
  outcomeDrift Float
  status       String // HEALTHY | WATCH | PAUSED | INSUFFICIENT_DATA
  notes        String?
  createdAt    DateTime @default(now())
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  email      String
  category   String
  // What the person is asking for, separate from the topic. Nullable because
  // tickets filed before the field existed never answered it: those are
  // labelled as inferred rather than silently claimed to be questions.
  type       String? // QUESTION | COMPLAINT | REQUEST | BUG
  subject    String
  message    String
  priority   String   @default("NORMAL") // human-set: URGENT | NORMAL
  status     String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  resolution String?
  assignedTo String?

  // Automated triage. Advisory only: it orders the queue and explains why, but
  // `priority` above stays the human-set field and always wins.
  severity       String? // CRITICAL | HIGH | MEDIUM | LOW
  urgency        String? // CRITICAL | HIGH | MEDIUM | LOW
  triageScore    Int?
  triageReason   String? // JSON list, written through serializeIssues
  triageVersion  String?
  triagedAt      DateTime?

  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category, status])
}

model CurriculumAction {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title        String
  skill        String?
  owner        String?
  status       String     @default("PROPOSED") // PROPOSED | PLANNED | IN_PROGRESS | COMPLETED
  dueDate      DateTime?
  outcomeNote  String?
  createdAt    DateTime   @default(now())
}

model Feedback {
  id             String   @id @default(cuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  technical      Int
  communication  Int
  teamwork       Int
  problemSolving Int
  adaptability   Int
  overall        Int
  notes          String?
  checkpointDays Int      @default(90) // 30 | 90 | 180
  dueAt          DateTime?
  createdAt      DateTime @default(now())

  @@unique([jobId, studentId, checkpointDays])
}

model BookmarkedJob {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, jobId])
}

// -----------------------------------------------------------------------
// Career interests: students follow companies and/or career tracks so the
// AI can proactively surface matches and skill-gap recommendations for
// them, even before a matching job is posted.
// -----------------------------------------------------------------------

model FavoriteCompany {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employerId String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, employerId])
}

model FavoriteCareerTrack {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerTrackId String // matches CareerTrack.id (DB-backed or static fallback), same convention as Student.targetCareer
  createdAt     DateTime @default(now())

  @@unique([studentId, careerTrackId])
}

// -----------------------------------------------------------------------
// University-provided courses/certifications. The AI matches these against
// a student's skill gaps for their favorite companies/career tracks, so a
// gap surfaces alongside the specific offering that closes it.
// -----------------------------------------------------------------------

model Offering {
  id              String         @id @default(cuid())
  universityId    String
  university      University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title           String
  type            String // course | certification
  description     String?
  url             String?
  certificationId String? // optional: this offering grants a specific catalog certification
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  skills OfferingSkill[]
}

model OfferingSkill {
  id         String   @id @default(cuid())
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([offeringId, skillId])
}